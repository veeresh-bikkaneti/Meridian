{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build && npm run db:migrate",
    "build:pages": "GITHUB_PAGES=1 node scripts/with-app-env.mjs vite build",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "check:contact": "node --experimental-strip-types scripts/contact-readiness.mjs",
    "test": "node --test 'scripts/**/*.test.mjs'; S1=$?; node --experimental-strip-types --test 'src/**/*.test.ts'; S2=$?; test $S1 -eq 0 -a $S2 -eq 0",
    "format": "prettier --write .",
    "prebuild": "node scripts/write-build-meta.mjs && node --experimental-strip-types scripts/check-generated-places.mjs && node scripts/lint-cards.mjs",
    "prebuild:pages": "node scripts/write-build-meta.mjs && node --experimental-strip-types scripts/check-generated-places.mjs && node scripts/lint-cards.mjs",
    "prebuild:dev": "node --experimental-strip-types scripts/check-generated-places.mjs && node scripts/lint-cards.mjs",
    "postbuild:pages": "node scripts/fingerprint-sw.mjs",
    "postbuild": "node scripts/fingerprint-sw.mjs",
    "test:worker": "node --experimental-strip-types --test workers/crash-report/src/index.test.ts",
    "typecheck:worker": "npx tsc -p workers/crash-report/tsconfig.json --noEmit",
    "smoke:crash": "node scripts/crash-smoke.mjs",
    "perf:bundle": "node scripts/bundle-report.mjs",
    "perf:globe-easy": "node scripts/perf-globe-easy.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@formkit/auto-animate": "0.10.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.169.2",
    "@tanstack/router-plugin": "^1.168.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@webgpu/types": "^0.1.74",
    "better-auth": "~1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "earcut": "^3.2.4",
    "jose": "6.2.9",
    "kysely": "^0.28.5",
    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "maplibre-gl": "^6.11.2",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.160.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.7.0",
    "us-atlas": "^3.0.1",
    "vite": "^8.2.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-test-renderer": "^19.3.0",
    "@types/three": "^0.160.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "react-test-renderer": "^19.3.0",
    "topojson-server": "3.0.1",
    "typescript-eslint": "^8.56.1"
  }
}
